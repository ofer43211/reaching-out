subgraph ACTUAL["ACTUAL — Events / Occurrences / Interventions"]
direction TB
A_WORLD["Shared Actual World<br/>events · interactions · artifacts · consequences"]:::actual
A_PROBE["Probe / Intervention<br/>action performed in the world"]:::actual
A_RESPONSE["World Response<br/>may confirm · disconfirm · surprise · refract"]:::actual
A_PROBE -->|"impact / effects"| A_WORLD
A_WORLD -->|"new occurrence"| A_RESPONSE
end

subgraph REAL["REAL — Structures / Mechanisms / Causal Powers"]
direction TB
G["GUILD — Candidate Relational Structure / Mechanism<br/><br/>visibility · access · costs · roles<br/>artifacts & memory · norms & language"]:::real
COND["Conditioning of Epistemic Process<br/><br/>shapes salience · framing · attention<br/>enables/constrains probes<br/>carries commitments<br/>may enhance OR dampen anomaly sensitivity"]:::real
FRINGE["FRINGE — Anomaly-Sensitivity Function<br/><br/>internally carried<br/>externally allocatable<br/>cross-cutting across transitions<br/><br/>FUNCTION MAY BE ASSIGNED<br/>IDENTITY MUST NOT OWN THE FUNCTION"]:::fringe
CONTRACT["Probe Contract Layer<br/><br/>purpose<br/>expected outcomes<br/>success / failure conditions<br/>risks · costs · responsibilities<br/>decision rules · rollback path"]:::contract
subgraph RECEIPTS["Typed Reality Receipts — required by claim/probe type"]
direction LR
R_INV["Inventory Receipt<br/>what exists / dependencies"]:::receipt
R_CTX["Context / Conditioning Receipt<br/>memory · framing · tools · visibility<br/>prior hypotheses · shared context"]:::receipt
R_RUN["Runtime / Instrument Receipt<br/>what actually executed"]:::receipt
R_EFF["Effect / Outcome Receipt<br/>what actually happened"]:::receipt
R_COST["Cost / Pressure Receipt<br/>who bore cost / pressure / risk"]:::receipt
end
ADMISSION["GATE 3 — Typed Receipt Admission<br/><br/>required receipts locked BEFORE probe<br/>missing receipt ≠ negative finding<br/>missing required receipt → NOT_ADMISSIBLE<br/>receipt substitution = forbidden"]:::warning
G --> COND
COND --> FRINGE
FRINGE --> CONTRACT
CONTRACT --> R_INV
CONTRACT --> R_CTX
CONTRACT --> R_RUN
CONTRACT --> R_EFF
CONTRACT --> R_COST
R_INV --> ADMISSION
R_CTX --> ADMISSION
R_RUN --> ADMISSION
R_EFF --> ADMISSION
R_COST --> ADMISSION
end

